<Window x:Class="ShapeWindowDemo.ShapeWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowChrome 示例窗口" Width="400" Height="280"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="16"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏，CaptionHeight 区域内需要设置 IsHitTestVisibleInChrome 才能响应鼠标 -->
            <Border Grid.Row="0" Background="#FF2D3B4F">
                <Grid>
                    <TextBlock Text="WindowChrome 示例窗口" Foreground="White"
                               VerticalAlignment="Center" Margin="12,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="&#x2014;" Width="40" Height="28" Margin="2"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Button_Minimize_Click" />
                        <Button Content="&#x25A1;" Width="40" Height="28" Margin="2"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Button_Maximize_Click" />
                        <Button Content="&#x2715;" Width="40" Height="28" Margin="2"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="Button_Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Border Grid.Row="1" Background="White">
                <TextBlock Text="内容区示例" Foreground="#FF333333"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
