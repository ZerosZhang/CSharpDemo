<Window x:Class="ShapeWindowDemo.MaximizeWindow3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无边框窗口（不遮挡任务栏）" Width="800" Height="450"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="微软雅黑" FontSize="16" Background="#FF1F2B38"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="无边框窗口（不遮挡任务栏）" Foreground="White" FontSize="28"
                   HorizontalAlignment="Center" />
        <TextBlock Text="WindowStyle=&quot;None&quot; + 按工作区摆放，任务栏仍然可见"
                   Foreground="#FF9FB3C8" HorizontalAlignment="Center" Margin="0,8,0,0" />

        <TextBlock x:Name="InfoTextBlock" Foreground="#FF9FB3C8"
                   HorizontalAlignment="Center" Margin="0,24,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
            <Button Content="贴合工作区" Width="140" Margin="4" Click="Button_WorkArea_Click" />
            <Button Content="用 MaximizedPrimaryScreen（对比）" Width="280" Margin="4"
                    Click="Button_MaximizedPrimaryScreen_Click" />
            <Button Content="关闭" Width="80" Margin="4" Click="Button_Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
