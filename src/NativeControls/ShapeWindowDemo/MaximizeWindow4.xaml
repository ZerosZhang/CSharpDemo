<Window x:Class="ShapeWindowDemo.MaximizeWindow4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowChrome 最大化窗口（不遮挡任务栏）" Width="800" Height="450"
        WindowState="Maximized"
        FontFamily="微软雅黑" FontSize="16" Background="#FF1F2B38"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#FF1F2B38">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏，CaptionHeight 区域内需要设置 IsHitTestVisibleInChrome 才能响应鼠标 -->
            <Border Grid.Row="0" Background="#FF1F2B38" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="WindowChrome 最大化窗口" Foreground="White"
                               VerticalAlignment="Center" Margin="12,0" />

                    <Button Content="&#x2715;" Width="40" Height="28" Margin="2"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Button_Close_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="WindowChrome 最大化（不遮挡任务栏）" Foreground="White" FontSize="28"
                           HorizontalAlignment="Center" />
                <TextBlock Text="WindowChrome + WindowState=&quot;Maximized&quot;，保留系统边框与拖拽缩放"
                           Foreground="#FF9FB3C8" HorizontalAlignment="Center" Margin="0,8,0,0" />

                <TextBlock x:Name="InfoTextBlock" Foreground="#FF9FB3C8"
                           HorizontalAlignment="Center" Margin="0,24,0,0" />

                <Button Content="关闭" Width="120" Margin="0,32,0,0" Click="Button_Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
