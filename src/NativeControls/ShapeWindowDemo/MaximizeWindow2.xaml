<Window x:Class="ShapeWindowDemo.MaximizeWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无边框最大化窗口（遮挡任务栏）" Width="800" Height="450"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        FontFamily="微软雅黑" FontSize="16" Background="#FF1F2B38"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="无边框最大化（遮挡任务栏）" Foreground="White" FontSize="28"
                   HorizontalAlignment="Center" />
        <TextBlock Text="WindowStyle=&quot;None&quot; + WindowState=&quot;Maximized&quot;，铺满整块屏幕"
                   Foreground="#FF9FB3C8" HorizontalAlignment="Center" Margin="0,8,0,0" />

        <TextBlock x:Name="InfoTextBlock" Foreground="#FF9FB3C8"
                   HorizontalAlignment="Center" Margin="0,24,0,0" />

        <Button Content="关闭" Width="120" Margin="0,32,0,0" Click="Button_Close_Click" />
    </StackPanel>
</Window>
