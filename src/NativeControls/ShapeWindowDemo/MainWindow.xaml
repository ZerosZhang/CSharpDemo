<Window x:Class="ShapeWindowDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomShapeWindowDemo" Width="440" Height="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="16">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <GroupBox Header="窗口形态">
            <StackPanel Margin="8">
                <Button Content="打开异形窗口" Margin="0,3" Click="Button_ShapeWindow_Click" />
                <Button Content="打开 WindowChrome 窗口" Margin="0,3" Click="Button_ChromeWindow_Click" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="最大化方式" Margin="0,12,0,0">
            <StackPanel Margin="8">
                <Button Content="W1 普通最大化窗口" Margin="0,3" Click="Button_MaximizeWindow1_Click" />
                <Button Content="W2 无边框最大化（遮挡任务栏）" Margin="0,3" Click="Button_MaximizeWindow2_Click" />
                <Button Content="W3 无边框窗口（不遮挡任务栏）" Margin="0,3" Click="Button_MaximizeWindow3_Click" />
                <Button Content="W4 WindowChrome 最大化（不遮挡任务栏）" Margin="0,3" Click="Button_MaximizeWindow4_Click" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</Window>
