<Window x:Class="TextBoxDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TextBoxDemo" Width="900" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="15"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>

    <Grid Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 问题复现 -->
        <GroupBox Grid.Column="0" Header="问题复现：绑定 double + PropertyChanged"
                  Margin="0,0,8,0" Padding="10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Tomato" Margin="0,0,0,8"
                           Text="试着输入 1.5：小数点敲不进去" />
                <TextBox Style="{StaticResource InputBoxStyle}"
                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock>
                    <Run Text="源属性 Amount = " />
                    <Run Text="{Binding Amount, Mode=OneWay}"
                         Foreground="#FF0077CC" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- 对照 -->
        <GroupBox Grid.Column="1" Header="对照：同样是 double，只是触发时机不同"
                  Margin="8,0,0,0" Padding="10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                           Text="LostFocus（TextBox.Text 的默认值）：输入过程不受打扰，1.5 正常输入，失焦才写回源" />
                <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding AmountLostFocus}" />
                <TextBlock>
                    <Run Text="源属性 AmountLostFocus = " />
                    <Run Text="{Binding AmountLostFocus, Mode=OneWay}"
                         Foreground="#FF0077CC" FontWeight="Bold" />
                </TextBlock>

                <Separator Margin="0,12" />

                <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                           Text="绑定 string + PropertyChanged：写回的字符串与输入完全一致，不会被覆盖" />
                <TextBox Style="{StaticResource InputBoxStyle}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock>
                    <Run Text="源属性 AmountText = " />
                    <Run Text="{Binding AmountText, Mode=OneWay}"
                         Foreground="#FF0077CC" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
