<Window x:Class="LongPressDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LongPressDemo"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LongPressDemo" Width="900" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="15">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="CountTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="按住鼠标左键不放，超过 500 毫秒算一次长按；中途松开、或把鼠标移出控件都会取消。" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 问题复现 -->
            <GroupBox Grid.Column="0" Header="问题复现：只在 XAML 里写附加事件"
                      Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Tomato" Margin="0,0,0,12"
                               Text="local:LongPress.LongPressed 只完成了事件订阅，XAML 并不会去调 AddLongPressedHandler，鼠标监听和计时器根本没装上——长按不会有任何反应。" />
                    <Button x:Name="Button_Xaml" Content="按住我（不会有反应）"
                            local:LongPress.LongPressed="Button_Xaml_LongPressed" />
                    <TextBlock Style="{StaticResource CountTextStyle}">
                        <Run Text="已触发：" />
                        <Run x:Name="Run_XamlCount" Text="0 次"
                             Foreground="#FF0077CC" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- 正确做法 -->
            <GroupBox Grid.Column="1" Header="正确做法：在 Code-Behind 里显式注册"
                      Margin="8,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,12"
                               Text="调用 LongPress.AddLongPressedHandler，订阅事件的同时会把鼠标监听和计时器一起装上。" />
                    <Button x:Name="Button_Code" Content="按住我（500ms 后触发）" />
                    <TextBlock Style="{StaticResource CountTextStyle}">
                        <Run Text="已触发：" />
                        <Run x:Name="Run_CodeCount" Text="0 次"
                             Foreground="#FF0077CC" FontWeight="Bold" />
                    </TextBlock>

                    <Separator Margin="0,16" />

                    <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,12"
                               Text="附加事件不限控件类型，Border 这类不处理鼠标事件的元素一样能用：" />
                    <Border x:Name="Border_Code" BorderBrush="#FF0077CC" BorderThickness="1"
                            CornerRadius="4" Background="#FFF0F6FF" Padding="12" Height="60">
                        <TextBlock Text="按住这块区域" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource CountTextStyle}">
                        <Run Text="已触发：" />
                        <Run x:Name="Run_BorderCount" Text="0 次"
                             Foreground="#FF0077CC" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="两个容易踩的点" Margin="0,12,0,0" Padding="12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="1. " FontWeight="Bold" />
                    <Run Text="XAML 附加事件语法必须靠 Add/Remove 访问器才能编译通过，但运行时不调用它们，所以访问器里的额外逻辑不会执行。" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run Text="2. " FontWeight="Bold" />
                    <Run Text="Button 会把鼠标按下标记成已处理，所以订阅鼠标事件时必须用 AddHandler 并传 handledEventsToo: true，否则收不到。" />
                </TextBlock>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
