<Window x:Class="ValidateDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:local="clr-namespace:ValidateDemo"
        Title="INotifyDataErrorInfo 校验 Demo" Width="460" Height="360"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="15"
        d:DataContext="{d:DesignInstance local:RegisterViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <local:ErrorsToMessageConverter x:Key="ErrorsToMessage" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="#FFFF4444" BorderThickness="1">
                                <AdornedElementPlaceholder x:Name="AdornedBox" />
                            </Border>
                            <TextBlock Foreground="#FFFF4444" FontSize="12" Margin="2,2,0,0"
                                       Text="{Binding AdornedElement.(Validation.Errors),
                                       ElementName=AdornedBox,
                                       Converter={StaticResource ErrorsToMessage}}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="注册信息（当字段非法时，绑定实时显示红框与错误提示）"
                  Padding="15" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="用户名" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="年龄" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="邮箱" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="注册" TextAlignment="Center" FontWeight="Bold" FontSize="18"
                           Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#FF666666"
                   Text="提示：清空或填入非法内容，输入框会变成红框；修改文本框时校验实时触发 ErrorsChanged 事件，控件自动刷新错误。" />
    </Grid>
</Window>
