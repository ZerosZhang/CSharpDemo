<Window x:Class="WindowShakeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowShakeDemo" Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="18">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Center" Margin="20">
        <Button Content="水平抖动" Click="Button_ShakeHorizontal_Click" />
        <Button Content="垂直抖动" Click="Button_ShakeVertical_Click" />
        <Button Content="大幅水平抖动" Click="Button_ShakeBig_Click" />
    </StackPanel>
</Window>
