<Window x:Class="DragReorderDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DragReorderDemo"
        Title="DragReorderDemo" Height="400" SizeToContent="Width"
        FontFamily="Consolas, 微软雅黑" FontSize="18"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="单列表拖拽">
            <ItemsControl ItemsSource="{Binding Items}"
                          Background="Transparent" local:DragReorder.IsEnabled="True" />
        </GroupBox>

        <GroupBox Grid.Column="1" Header="跨列表拖拽">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding ListA}" Grid.Column="0"
                              Background="Transparent" local:CrossDragReorder.IsEnabled="True" />

                <ItemsControl ItemsSource="{Binding ListB}" Grid.Column="1"
                              Background="Transparent" local:CrossDragReorder.IsEnabled="True" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
