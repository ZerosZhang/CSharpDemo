<Window x:Class="IsolatedStorageDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="IsolatedStorageDemo" Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="15"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 启动次数：值来自 Application.Properties，持久化在独立存储里 -->
        <Border Grid.Row="0" Padding="16" Background="#FFF5F5F5"
                BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="这是第" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SessionCount}" Margin="8,0"
                           FontSize="30" FontWeight="Bold" Foreground="#FF0077CC"
                           VerticalAlignment="Center" />
                <TextBlock Text="次启动" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Properties 的内容：说明它是 object 字典，值会被 json 往返改变类型 -->
        <GroupBox Grid.Row="1" Header="Application.Properties 的内容" Margin="0,12,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                           Text="值统一以 object 存放：程序刚写进去的是 int，从 json 读回来后就变成 JsonElement，所以要按两种类型取值。" />

                <ListView Grid.Row="1" ItemsSource="{Binding PropertyEntries}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="键" Width="240" DisplayMemberBinding="{Binding Key}" />
                            <GridViewColumn Header="值" Width="320" DisplayMemberBinding="{Binding Value}" />
                            <GridViewColumn Header="值的类型" Width="220" DisplayMemberBinding="{Binding ValueType}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                       Text="「计数 +1」只改内存，点「保存」才写进独立存储；「重新加载」会把值变回 JsonElement。" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Button_Increment" Content="计数 +1" Click="Button_Increment_Click" />
                <Button x:Name="Button_Save" Content="保存" Click="Button_Save_Click" />
                <Button x:Name="Button_Load" Content="重新加载" Click="Button_Load_Click" />
                <Button x:Name="Button_Clear" Content="清除存储数据" Click="Button_Clear_Click" />
                <Button x:Name="Button_OpenStore" Content="打开存储根目录" Click="Button_OpenStore_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
